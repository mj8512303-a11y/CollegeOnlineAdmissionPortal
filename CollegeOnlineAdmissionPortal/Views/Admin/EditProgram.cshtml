@model CollegeOnlineAdmissionPortal.Models.Program

@{
    ViewBag.Title = "Edit Program";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">Edit Program</h3>
        <a href="@Url.Action("ManagePrograms","Admin")"
           class="btn btn-outline-success">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Updated!',
                text: '@TempData["Success"]',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ProgramID)

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Program Name</label>
                        @Html.TextBoxFor(m => m.ProgramName,
                            new { @class = "form-control", required = "required" })
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Program Level</label>
                        @Html.TextBoxFor(m => m.ProgramLevel,
                            new { @class = "form-control", required = "required" })
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Duration</label>
                        @Html.TextBoxFor(m => m.Duration,
                            new { @class = "form-control", required = "required" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Department</label>
                        @Html.DropDownListFor(m => m.DepartmentID,
                            new SelectList(ViewBag.Departments, "DepartmentID", "DepartmentName", Model.DepartmentID),
                            "Select Department",
                            new { @class = "form-select", required = "required" })
                    </div>

                    <div class="col-md-6 d-flex align-items-center mt-4">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive,
                                new { @class = "form-check-input" })
                            <label class="form-check-label ms-2">
                                Active Program
                            </label>
                        </div>
                    </div>

                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa-solid fa-save"></i> Update Program
                        </button>
                    </div>

                </div>
            }

        </div>
    </div>

</div>