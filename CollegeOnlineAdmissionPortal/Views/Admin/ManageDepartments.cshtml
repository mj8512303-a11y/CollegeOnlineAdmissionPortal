@model IEnumerable<CollegeOnlineAdmissionPortal.Models.Department>

@{
    ViewBag.Title = "Manage Departments";
}
<style>
    .action-btn {
        transition: all 0.3s ease;
        border-radius: 8px;
    }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

    .edit-btn:hover i {
        color: #0d6efd !important;
    }

    .delete-btn:hover i {
        color: #dc3545 !important;
    }
</style>
<div class="container mt-4">
    <h3>Manage Departments</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }


    @using (Html.BeginForm("AddDepartment", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row mb-3">
            <div class="col-md-5">
                <input type="text" name="DepartmentName"
                       class="form-control"
                       placeholder="Enter Department Name" required />
            </div>

            <div class="col-md-4">
                <input type="text" name="DepartmentCode"
                       class="form-control"
                       placeholder="Enter Department Code (e.g. CS)" required />
            </div>

            <div class="col-md-3">
                <button class="btn btn-primary w-100">Add</button>
            </div>
        </div>
    }


    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Department Name</th>
                <th>Department Code</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dept in Model)
            {
                <tr>
                    <td>@dept.DepartmentID</td>
                    <td>@dept.DepartmentName</td>
                    <td>@dept.DepartmentCode</td>
                    <td>
                        @*<td>
                                <a href="@Url.Action("EditDepartment", "Admin", new { id = dept.DepartmentID })"
                                   class="btn btn-sm btn-outline-primary">Edit</a>


                                <a href="@Url.Action("DeleteDepartment", "Admin", new { id = dept.DepartmentID })"
                                   class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>*@
                            
                    <td>
                        @*//Edit Button*@
                        <a href="@Url.Action("EditDepartment", "Admin", new { id = dept.DepartmentID })"
                           class="btn btn-sm btn-primary border shadow-sm me-2 action-btn edit-btn"
                           title="Edit">
                            <i class="fa-solid fa-pen-to-square text-primary"></i>
                        </a>

                        @*/Delete Button*@ 
                        <a href="javascript:void(0);"
                           onclick="confirmDelete(@dept.DepartmentID)"
                           class="btn btn-sm btn-dark border shadow-sm action-btn delete-btn"
                           title="Delete">
                            <i class="fa-solid fa-trash text-danger"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a href="@Url.Action("Dashboard","Admin")"
       class="btn btn-outline-success mb-3">
        ← Back to Dashboard
    </a>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success',
            text: '@TempData["Success"]'
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: '@TempData["Error"]'
        });
    </script>
}
<script>
    function confirmDelete(id) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This department will be deleted permanently!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/Admin/DeleteDepartment/' + id;
            }
        });
    }
</script>
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["SuccessMessage"]',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
}