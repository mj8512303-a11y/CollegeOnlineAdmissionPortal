<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Free Bootstrap Admin Template : Binary Admin</title>
    <!-- BOOTSTRAP STYLES-->
    <link href="~/Content/Admin/assets/css/bootstrap.css" rel="stylesheet" />
    <!-- FONTAWESOME STYLES-->
    <link href="~/Content/Admin/assets/css/font-awesome.css" rel="stylesheet" />
    <!-- MORRIS CHART STYLES-->
    <link href="~/Content/Admin/assets/js/morris/morris-0.4.3.min.css" rel="stylesheet" />
    <!-- CUSTOM STYLES-->
    <link href="~/Content/Admin/assets/css/custom.css" rel="stylesheet" />
    <!-- GOOGLE FONTS-->
    <link href='http://fonts.googleapis.com/css?family=Open+Sans' rel='stylesheet' type='text/css' />
</head>
<style>
    #main-menu {
        background-color: #2c3e50;
        min-height: 100vh;
    }

        #main-menu .nav-link {
            color: #fff;
            padding: 12px 15px;
            display: block;
        }

            #main-menu .nav-link:hover {
                background-color: #1abc9c;
                color: #fff;
            }

    .active-menu {
        background-color: #16a085;
    }

    #main-menu i {
        margin-right: 8px;
    }
    .logo-area {
        padding: 25px 0;
    }

        .logo-area img {
            width: 90px;
            border-radius: 50%;
            margin: auto;
        }
</style>

<body>
    <div id="wrapper">
        <nav class="navbar navbar-default navbar-cls-top " role="navigation" style="margin-bottom: 0">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".sidebar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @*<a class="navbar-brand" href="index.html">Hello! @Session["FullName"]</a>*@
                @*<h5>
                    Hello, <span class="username">@User.Identity.Name</span> 👋
                </h5>*@
            </div>
            
        </nav>
        <!-- /. NAV TOP  -->
        <nav class="navbar-default navbar-side" role="navigation">
            <div class="sidebar-collapse">
                
                <ul class="nav flex-column" id="main-menu">
                   
                    <li class="text-center logo-area">
                        <img src="~/Content/Admin/assets/img/iub.jpg" class="img-responsive" />
                    </li>
                    
                    


                    <li class="nav-item">
                        <a class="nav-link active-menu" href="@Url.Action("Dashboard","Admin")">
                            <i class="fa fa-dashboard"></i> Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("ManageDepartments","Admin")">
                            <i class="bi bi-building"></i> Departments
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("ManageUsers","Admin")">
                            <i class="fa fa-users"></i> Users
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("ManagePrograms","Admin")">
                            <i class="fa fa-bar-chart-o"></i> Manage Programs
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Login","Account")" class="btn btn-danger square-btn-adjust">
                            <i class="fa fa-sign-out"></i> Logout
                        </a>
                    </li>
                </ul>

                



            </div>


        </nav>
        <!-- /. NAV SIDE  -->
        <div id="page-wrapper">
            <div id="page-inner">
                <div class="row">
                    <div class="col-md-12">
                        @*<h2 style="color:forestgreen">Admin Dashboard</h2>
        <h5 style="color:blue">Welcome To Online College Admission Portal</h5>*@
                        <h2 style="font-weight:600;color:#2c3e50">
                            Admin Dashboard
                        </h2>

                        <p style="color:#7f8c8d">
                            Welcome To Online College Admission Portal
                        </p>
                    </div>
                </div>

                <!-- /. ROW  -->
                <hr />


                <!-- /. ROW  -->
                @RenderBody()
                
                <footer class="footer-container">
                    @*<span>&copy; @DateTime.Now</span>*@
                </footer>
                
            </div>
       </div>
     </div>
            <!-- /. PAGE INNER
        <!-- /. PAGE WRAPPER  -->
            <!-- /. WRAPPER  -->
            <!-- SCRIPTS -AT THE BOTOM TO REDUCE THE LOAD TIME-->
            <!-- JQUERY SCRIPTS -->
            <script src="~/Content/Admin/assets/js/jquery-1.10.2.js"></script>
            <!-- BOOTSTRAP SCRIPTS -->
            <script src="~/Content/Admin/assets/js/bootstrap.min.js"></script>
            <!-- METISMENU SCRIPTS -->
            <script src="~/Content/Admin/assets/js/jquery.metisMenu.js"></script>
            <!-- MORRIS CHART SCRIPTS -->
            <script src="~/Content/Admin/assets/js/morris/raphael-2.1.0.min.js"></script>
            <script src="~/Content/Admin/assets/js/morris/morris.js"></script>
            <!-- CUSTOM SCRIPTS -->
            <script src="~/Content/Admin/assets/js/custom.js"></script>


</body>
</html>
                               
