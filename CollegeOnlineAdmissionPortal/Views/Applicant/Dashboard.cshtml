                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Are you sure?')">Delete</a>

                            @if (app.Status == "Approved" && (payment == null || payment.PaymentStatus != "Paid"))
                            {
                                <a href="@Url.Action("MakePayment", "Payment", new { appId = app.ApplicantID })"
                                   class="btn btn-sm btn-primary">Pay Now</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    }
