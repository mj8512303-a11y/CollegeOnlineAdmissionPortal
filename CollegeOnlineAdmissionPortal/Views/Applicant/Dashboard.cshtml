    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Program</th>
                    <th>Academic Year</th>
                    <th>Application Status</th>
                    <th>Payment Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in ViewBag.Applications as List<ApplicationForm>)
                {
                    var payments = ViewBag.Payments as List<Payment>;
                    var payment = payments.FirstOrDefault(p => p.ApplicantID == app.ApplicantID);

                    <tr>
                        <td>@app.ProgramAppliedFor</td>
                        <td>@app.AcademicYear</td>

