@model CollegeOnlineAdmissionPortal.Models.ViewModels.ApplicantDashboardViewModel


@{
    ViewBag.Title = "Applicant Dashboard";
    Layout = "~/Views/Shared/_ApplicantLayout.cshtml";
}

<h3 class="mb-4">Welcome, @Model.ApplicantName 👋</h3>

<div class="row">

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-file-earmark-text fs-1 text-primary"></i>
                <h5>Applications</h5>
                <h3>@Model.TotalApplications</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-cash-stack fs-1 text-success"></i>
                <h5>Payments</h5>
                <h3>@Model.TotalPayments</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-award fs-1 text-warning"></i>
                <h5>Admission Status</h5>
                <h6>@Model.AdmissionStatus</h6>
            </div>
        </div>
    </div>

</div>

<hr />

