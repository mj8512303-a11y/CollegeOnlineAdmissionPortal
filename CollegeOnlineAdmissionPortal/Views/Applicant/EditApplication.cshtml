@model CollegeOnlineAdmissionPortal.Models.ApplicationForm

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.FormID)
    @Html.HiddenFor(m => m.ApplicantID)

    <div class="form-group">
        <label>Program</label>
        @Html.DropDownListFor(m => m.ProgramAppliedFor,
            new SelectList(ViewBag.Programs, "ProgramName", "ProgramName"),
            "-- Select Program --",
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Academic Year</label>
        @Html.TextBoxFor(m => m.AcademicYear, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
}
