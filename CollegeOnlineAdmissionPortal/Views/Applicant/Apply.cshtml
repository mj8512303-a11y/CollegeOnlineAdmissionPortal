@model CollegeOnlineAdmissionPortal.Models.ViewModels.ApplyViewModel

@{
    ViewBag.Title = "Apply for Admission";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Apply for Admission</h4>
        </div>

        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

           
            @using (Html.BeginForm("Apply", "Applicant", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    <label>Program</label>
                    @Html.DropDownListFor(m => m.Application.ProgramID,
                        new SelectList(Model.Programs, "ProgramID", "ProgramName"),
                        "-- Select Program --", new { @class = "form-control" })
                </div>

                <div class="mb-3">
                    <label>Academic Year</label>
                    @Html.TextBoxFor(m => m.Application.AcademicYear,
                        new { @class = "form-control", placeholder = "2025-2026" })
                </div>

                <div class="mb-3">
                    <label>Total Marks</label>
                    @Html.TextBoxFor(m => m.Application.TotalMarks,
                        new { @class = "form-control", type = "number", min = "0" })
                </div>

                <!-- Submit Button -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-success">
                        Submit Application
                    </button>
                </div>
            }
        </div>
    </div>
    <div class="d-flex justify-content-start mt-3">
        <a href="@Url.Action("Dashboard", "Applicant")"
           class="btn btn-outline-primary btn-lg shadow-sm">
            ⬅ Back to Dashboard
        </a>
    </div>
</div>