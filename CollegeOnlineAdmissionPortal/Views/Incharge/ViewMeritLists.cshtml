@model List<CollegeOnlineAdmissionPortal.Models.ViewModels.MeritViewModel>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">

    <h2 class="text-center fw-bold text-primary mb-4">🏆 Professional Merit Lists</h2>


    @*@foreach (var group in Model.GroupBy(x => new { x.Course, x.AcademicYear, x.PublishedDate }))
        {
            <div class="card shadow-lg mb-5 border-0 rounded-4">

                <div class="card-header bg-dark text-white d-flex justify-content-between">
                    <div>
                        <h5>@group.Key.Course (@group.Key.AcademicYear)</h5>
                    </div>
                    <div>*@
    @foreach (var group in Model.GroupBy(x => new { x.MeritListID, x.Course, x.AcademicYear, x.PublishedDate }))
    {
        <div class="card shadow-lg mb-4">

            <div class="card-header d-flex justify-content-between">
                <div>
                    <strong>@group.Key.Course (@group.Key.AcademicYear)</strong>
                </div>

                <div>
                    <a href="@Url.Action("PrintMeritList", "Incharge", new { id = group.Key.MeritListID })"
                       class="btn btn-sm btn-light"
                       target="_blank">
                        🖨 Print
                    </a>

                    <a href="@Url.Action("DownloadMeritList", "Incharge", new { id = group.Key.MeritListID })"
                       class="btn btn-sm btn-success">
                        ⬇ Download PDF
                    </a>
                </div>
            </div>
            Published:
            @(group.Key.PublishedDate.HasValue
                        ? group.Key.PublishedDate.Value.ToString("dd-MMM-yyyy")
                        : "Not Published")
        </div>
  

            <div class="card-body">

                <!-- Summary Section -->
                <div class="row text-center mb-4">

                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded shadow-sm">
                            <h6>Total Students</h6>
                            <h4 class="text-primary">@group.Count()</h4>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded shadow-sm">
                            <h6>Selected (Top 5)</h6>
                            <h4 class="text-success">
                                @group.Count(x => x.Status == "Selected")
                            </h4>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded shadow-sm">
                            <h6>Average Percentage</h6>
                            <h4 class="text-warning">
                                @group.Average(x => x.Percentage).ToString("0.00") %
                            </h4>
                        </div>
                    </div>

                </div>

                <!-- Merit Table -->
                <div class="table-responsive">
                    <table class="table table-hover text-center align-middle">

                        <thead class="table-primary">
                            <tr>
                                <th>Rank</th>
                                <th>Applicant</th>
                                <th>Total Marks</th>
                                <th>Percentage</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in group.OrderBy(x => x.Rank))
                            {
                                string rowClass = item.Rank == 1 ? "table-warning"
                                               : item.Rank == 2 ? "table-secondary"
                                               : item.Rank == 3 ? "table-info"
                                               : "";

                                <tr class="@rowClass">

                                    <td class="fw-bold">
                                        @item.Rank
                                        @if (item.Rank == 1)
                                        {<span class="badge bg-warning text-dark">🥇</span> }
                                        else if (item.Rank == 2)
                                        { <span class="badge bg-secondary">🥈</span> }
                                        else if (item.Rank == 3)
                                        { <span class="badge bg-info text-dark">🥉</span>}
                                    </td>

                                    <td>@item.ApplicantName</td>

                                    <td class="fw-bold text-success">
                                        @item.TotalMarks
                                    </td>

                                    <td class="fw-bold text-primary">
                                        @item.Percentage.ToString("0.00") %
                                    </td>

                                    <td>
                                        @if (item.Status == "Selected")
                                        {
                                            <span class="badge bg-success">Selected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Waiting</span>
                                        }
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
       
    }

    <a href="@Url.Action("Dashboard", "Incharge")"
       class="btn btn-primary">
        ⬅ Back to Dashboard
    </a>

</div>
