@{
    ViewBag.Title = "Create Merit List";
}

<h3>Create Merit List</h3>

<select id="ProgramID" class="form-control mb-2">
    <option value="">Select Program</option>
    @foreach (var p in ViewBag.Programs)
    {
        <option value="@p.ProgramID">@p.ProgramName</option>
    }
</select>

<input type="text" id="AcademicYear" class="form-control mb-2" placeholder="2025-2026" />

<button class="btn btn-success" onclick="createMerit()">Create Merit List</button>
<a href="@Url.Action("Dashboard", "Incharge")"
   class="btn btn-outline-dark btn-sm">
    <i class="bi bi-arrow-left-circle me-1"></i>
    ⬅ Back to Dashboard
</a>

<script>
    function createMerit() {
        $.post('/Incharge/CreateMeritListAjax', {
            ProgramID: $('#ProgramID').val(),
            AcademicYear: $('#AcademicYear').val()
        }, function (res) {
            alert(res.message);
        });
    }
</script>
