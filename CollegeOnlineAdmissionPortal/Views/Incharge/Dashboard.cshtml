@{
    ViewBag.Title = "Admission Incharge Dashboard";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    @*<a href="~/Views/Shared/_InchargeLayout.cshtml"></a>*@

int totalApplications = ViewBag.TotalApplications ?? 0;
int approved = ViewBag.Approved ?? 0;
int rejected = ViewBag.Rejected ?? 0;
int pending = totalApplications - (approved + rejected);
}

<h2 class="mb-4">Welcome, Admission Incharge</h2>

<div class="row g-4">

    <div class="col-md-3 col-sm-6">
        <div class="card shadow border-start border-primary">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-file-earmark-text-fill text-primary fs-1 me-3"></i>
                <div>
                    <h6 class="mb-0">Total Applications</h6>
                    <h3>@totalApplications</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card shadow border-start border-success">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-check-circle-fill text-success fs-1 me-3"></i>
                <div>
                    <h6 class="mb-0">Approved</h6>
                    <h3>@approved</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card shadow border-start border-danger">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-x-circle-fill text-danger fs-1 me-3"></i>
                <div>
                    <h6 class="mb-0">Rejected</h6>
                    <h3>@rejected</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card shadow border-start border-warning">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-hourglass-split text-warning fs-1 me-3"></i>
                <div>
                    <h6 class="mb-0">Pending</h6>
                    <h3>@pending</h3>
                </div>
            </div>
        </div>
    </div>

</div>