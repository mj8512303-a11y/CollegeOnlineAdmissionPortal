@model List<CollegeOnlineAdmissionPortal.Models.ViewModels.MeritViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Merit List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            padding: 40px;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .signature {
            margin-top: 80px;
            text-align: right;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>

<body>

    <div class="header">
        <h2>🏆 College Online Admission Portal</h2>
        <h4>Official Merit List</h4>
        <p>
            Course: <strong>@Model.First().Course</strong> |
            Academic Year: <strong>@Model.First().AcademicYear</strong>
        </p>
        <p>
            Published:
            @(Model.First().PublishedDate?.ToString("dd-MMM-yyyy"))
        </p>
    </div>

    <table class="table table-bordered text-center">
        <thead class="table-dark">
            <tr>
                <th>Rank</th>
                <th>Applicant Name</th>
                <th>Total Marks</th>
                <th>Percentage</th>
                <th>GPA</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Rank</td>
                    <td>@item.ApplicantName</td>
                    <td>@item.TotalMarks</td>
                    <td>@item.Percentage.ToString("0.00") %</td>
                    <td>@item.GPA</td>
                    <td>
                        @if (item.Status == "Selected")
                        {
                            <span class="badge bg-success">Selected</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Waiting</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="signature">
        <p>__________________________</p>
        <p><strong>Admission Incharge</strong></p>
    </div>

    <div class="text-center mt-4 no-print">
        <button onclick="window.print()" class="btn btn-primary">
            🖨 Print
        </button>
    </div>
    <script>
        success: function (response) {
            if (response.success) {

                alert(response.message);

                window.open(response.pdfUrl, '_blank');

                setTimeout(function () {
                    window.location.href = '/Incharge/ViewMeritLists';
                }, 2000);
            }
        }
    </script>

</body>
</html>
