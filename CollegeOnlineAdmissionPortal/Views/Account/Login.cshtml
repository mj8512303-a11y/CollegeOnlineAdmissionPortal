<!DOCTYPE html>
<html>
<head>
    <title>College Admission Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>

/* ================= BACKGROUND ================= */

body{
    margin:0;
    height:100vh;
    overflow:hidden;
    font-family:'Segoe UI',sans-serif;
    background: linear-gradient(-45deg,#0f2027,#203a43,#2c5364,#1c1c3c,#3a1c71);
    background-size:400% 400%;
    animation: gradientMove 15s ease infinite;
}

@@keyframes gradientMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
}

/* Stars */
.stars{
    position:absolute;
    width:100%;
    height:100%;
    background:
        radial-gradient(2px 2px at 20px 30px, #fff, transparent),
        radial-gradient(2px 2px at 40px 70px, #00eaff, transparent),
        radial-gradient(2px 2px at 90px 40px, #ff00ff, transparent),
        radial-gradient(2px 2px at 130px 80px, #ffff00, transparent),
        radial-gradient(2px 2px at 160px 120px, #ff6600, transparent);
    background-repeat: repeat;
    background-size:200px 200px;
    animation: moveStars 60s linear infinite;
}

@@keyframes moveStars{
    from{transform:translateY(0);}
    to{transform:translateY(-1000px);}
}

/* Shooting Star */
.shooting-star{
    position:absolute;
    top:20%;
    left:-200px;
    width:200px;
    height:2px;
    background:linear-gradient(90deg,white,transparent);
    animation:shoot 6s linear infinite;
}

@@keyframes shoot{
    0%{left:-200px; top:10%;}
    100%{left:100%; top:70%;}
}

/* ================= LOGIN CARD ================= */

.login-wrapper{
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    position:relative;
    z-index:10;
}

.login-card{
    width:420px;
    padding:45px;
    border-radius:20px;
    backdrop-filter:blur(20px);
    background:rgba(255,255,255,0.08);
    box-shadow:0 20px 50px rgba(0,0,0,0.6);
    color:white;
}

.form-control{
    background:transparent;
    border:1px solid rgba(255,255,255,0.4);
    color:white;
}

.form-control:focus{
    background:transparent;
    border-color:#00eaff;
    box-shadow:none;
    color:white;
}

/* ================= ROLE DROPDOWN ================= */

.custom-select-box{
    background:rgba(255,255,255,0.1);
    padding:12px 15px;
    border-radius:8px;
    cursor:pointer;
    border:1px solid rgba(255,255,255,0.3);
    color:white;
    transition:0.3s;
}

.custom-select-box:hover{
    background:rgba(255,255,255,0.2);
}

.custom-dropdown{
    position:absolute;
    width:100%;
    background:rgba(0,0,0,0.95);
    border-radius:8px;
    margin-top:5px;
    display:none;
    animation:fadeIn 0.3s ease;
    z-index:100;
}

.dropdown-item-custom{
    padding:10px 15px;
    cursor:pointer;
    color:white;
}

.dropdown-item-custom:hover{
    background:#0072ff;
}

.rotate{
    transform:rotate(180deg);
    transition:0.3s;
}

@@keyframes fadeIn{
    from{opacity:0; transform:translateY(-5px);}
    to{opacity:1; transform:translateY(0);}
}

/* Button */

.btn-login{
    background:linear-gradient(90deg,#00eaff,#0072ff);
    border:none;
    font-weight:600;
}

.btn-login:hover{
    box-shadow:0 0 20px #00eaff;
}

.error-text{
    min-height:25px;
}

    </style>
</head>

<body>

    <div class="stars"></div>
    <div class="shooting-star"></div>

    <div class="login-wrapper">

        <div class="login-card">

            <h3 class="text-center mb-4">🎓 College Admission Portal</h3>

            <div class="mb-3">
                <input type="email" id="email" class="form-control" placeholder="Email Address">
            </div>

            <div class="mb-3">
                <input type="password" id="password" class="form-control" placeholder="Password">
            </div>

            <!-- Role Dropdown -->
            <div class="mb-4 position-relative">
                <div class="custom-select-box" onclick="toggleDropdown()">
                    <span id="selectedRoleText">
                        <i class="bi bi-person-circle"></i> Select Role
                    </span>
                    <i id="arrowIcon" class="bi bi-chevron-down float-end"></i>
                </div>

                <div class="custom-dropdown" id="roleDropdown">
                    <div class="dropdown-item-custom" onclick="selectRole('Applicant','bi-person')">
                        <i class="bi bi-person"></i> Applicant
                    </div>
                    <div class="dropdown-item-custom" onclick="selectRole('AdmissionIncharge','bi-briefcase')">
                        <i class="bi bi-briefcase"></i> Admission Incharge
                    </div>
                    <div class="dropdown-item-custom" onclick="selectRole('Admin','bi-shield-lock')">
                        <i class="bi bi-shield-lock"></i> Administrator
                    </div>
                </div>

                <input type="hidden" id="selectedRole">
            </div>

            <button class="btn btn-login w-100" onclick="loginUser()">Login</button>

            <div class="error-text text-warning text-center mt-3" id="errorMsg"></div>

        </div>
    </div>

    <script>

        function toggleDropdown() {
            $("#roleDropdown").toggle();
            $("#arrowIcon").toggleClass("rotate");
        }

        function selectRole(role, icon) {
            $("#selectedRole").val(role);
            $("#selectedRoleText").html('<i class="bi ' + icon + '"></i> ' + role);
            $("#roleDropdown").hide();
            $("#arrowIcon").removeClass("rotate");
        }

        $(document).click(function (e) {
            if (!$(e.target).closest('.position-relative').length) {
                $("#roleDropdown").hide();
                $("#arrowIcon").removeClass("rotate");
            }
        });

        function loginUser() {

            $("#errorMsg").text("");

            $.ajax({
                url: '/Account/LoginAjax',
                type: 'POST',
                data: {
                    email: $("#email").val(),
                    password: $("#password").val(),
                    role: $("#selectedRole").val()
                },
                success: function (res) {
                    if (res.success) {
                        window.location.href = res.redirect;
                    }
                    else {
                        $("#errorMsg").text(res.message);
                    }
                }
            });
        }

    </script>

</body>
</html>
